<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>오늘 당신에게 어울리는 영화는?</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gamja+Flower&family=Jua&family=Noto+Sans+KR:wght@700;800;900&display=swap">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        jua: ['Jua', 'sans-serif'],
                        gamja: ['Gamja Flower', 'cursive'],
                        noto: ['Noto Sans KR', 'sans-serif'],
                    },
                    colors: {
                        brandYellow: '#FFD166',
                        brandPink: '#FF70A6',
                        brandPurple: '#70D6FF',
                        brandGreen: '#06D6A0',
                        brandOrange: '#FF9F1C',
                    },
                    animation: {
                        'bounce-slow': 'bounce 2s infinite',
                        'pulse-slow': 'pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'float': 'float 3s ease-in-out infinite',
                        'wiggle': 'wiggle 1s ease-in-out infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        wiggle: {
                            '0%, 100%': { transform: 'rotate(-3deg)' },
                            '50%': { transform: 'rotate(3deg)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Jua', sans-serif;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }
        .font-gamja-style {
            font-family: 'Gamja Flower', cursive;
        }
        .custom-shadow {
            box-shadow: 0 8px 0 0 rgba(0, 0, 0, 0.15);
        }
        .btn-press {
            transition: all 0.1s ease;
        }
        .btn-press:active {
            transform: translateY(6px);
            box-shadow: 0 2px 0 0 rgba(0, 0, 0, 0.15);
        }
    </style>
</head>
<body class="bg-amber-100 min-h-screen flex items-center justify-center p-3 sm:p-5 select-none overflow-x-hidden font-jua">

    <!-- Container Frame -->
    <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl border-4 border-amber-300 overflow-hidden relative min-h-[640px] flex flex-col justify-between">
        
        <!-- HEADER DECORATION -->
        <div class="bg-gradient-to-r from-amber-300 via-orange-300 to-pink-300 p-3 text-center flex justify-between items-center px-5 border-b-4 border-amber-200">
            <span class="text-2xl animate-bounce">🎬</span>
            <span class="text-2xl font-extrabold text-amber-950 tracking-wider font-noto">영화 취향 MBTI</span>
            <span class="text-2xl animate-bounce">🍿</span>
        </div>

        <!-- SCREEN 1: START SCREEN -->
        <div id="start-screen" class="p-5 text-center flex-1 flex flex-col justify-between items-center my-auto">
            <div class="my-auto space-y-4 w-full">
                <!-- Club & Festival Badge Header -->
                <div class="space-y-1.5">
                    <div class="inline-block bg-amber-400 text-amber-950 font-bold text-sm sm:text-base px-4 py-1 rounded-full border-2 border-amber-600 shadow-sm animate-pulse-slow">
                        신남초 동아리 축제
                    </div>
                    <div class="text-pink-600 font-bold text-xl sm:text-2xl tracking-wider">
                        📚 독서영감 동아리
                    </div>
                </div>

                <!-- Cute Graphic Badge & Character -->
                <div class="relative inline-block animate-float my-2">
                    <div class="w-32 h-32 sm:w-36 sm:h-36 bg-amber-100 rounded-full flex items-center justify-center border-4 border-amber-400 mx-auto shadow-inner relative">
                        <span class="text-6xl sm:text-7xl">🍿✨</span>
                        <!-- Mini Character Overlay -->
                        <span class="absolute -bottom-1 -right-1 text-3xl animate-wiggle">🐻</span>
                    </div>
                    <span class="absolute -top-1 -right-2 bg-pink-500 text-white font-bold text-xs px-3 py-1 rounded-full border-2 border-white shadow-md">추천 부스</span>
                </div>

                <!-- Title Header -->
                <div>
                    <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 leading-tight">
                        오늘 당신에게<br><span class="text-pink-500 underline decoration-wavy decoration-amber-300">어울리는 영화</span>는?
                    </h1>
                </div>

                <!-- Mission Stamp Banner -->
                <div class="bg-gradient-to-r from-amber-50 to-orange-50 p-3.5 rounded-2xl border-2 border-dashed border-amber-300 text-amber-900 text-sm sm:text-base">
                    <div class="flex items-center justify-center space-x-1.5 text-pink-600 font-bold mb-1">
                        <span class="text-lg">🏵️</span>
                        <span>미션을 달성하고 스탬프를 받아가세요!</span>
                    </div>
                    <p class="text-gray-600 font-gamja-style text-lg sm:text-xl">
                        딱 4가지 질문에 답하면 나에게 꼭 맞는 영화가 짜잔! 🎈
                    </p>
                </div>
            </div>

            <!-- Start Button -->
            <button onclick="startQuiz()" class="w-full bg-pink-500 hover:bg-pink-600 text-white font-bold text-2xl py-4 px-6 rounded-2xl border-b-8 border-pink-700 btn-press custom-shadow flex items-center justify-center space-x-2 mt-3">
                <span>테스트 시작하기</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        <!-- SCREEN 2: QUESTION SCREEN (Hidden initially) -->
        <div id="question-screen" class="hidden p-5 flex-1 flex flex-col justify-between">
            <!-- Progress Bar -->
            <div>
                <div class="flex justify-between items-center mb-1">
                    <span id="question-number" class="text-amber-700 text-base">질문 1 / 4</span>
                    <span id="progress-percent" class="text-amber-600 text-sm">25% 완료</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-4 border-2 border-gray-300 overflow-hidden">
                    <div id="progress-bar" class="bg-gradient-to-r from-amber-400 to-pink-500 h-full rounded-full transition-all duration-300 ease-out" style="width: 25%"></div>
                </div>
            </div>

            <!-- Question & Choices -->
            <div class="my-auto py-3 space-y-5">
                <!-- Question Card -->
                <div class="bg-amber-50 p-5 rounded-2xl border-2 border-amber-200 text-center shadow-sm">
                    <h2 id="question-text" class="text-2xl sm:text-3xl text-gray-800 leading-relaxed">
                        ☀️ 오늘 나의 기분은 어떤가요?
                    </h2>
                </div>

                <!-- Choice Options -->
                <div class="space-y-3">
                    <button onclick="selectOption('A')" class="w-full bg-white hover:bg-orange-50 border-4 border-orange-300 hover:border-orange-400 text-left p-4 rounded-2xl btn-press flex items-center space-x-3 transition-colors shadow-sm">
                        <span class="text-4xl shrink-0" id="optA-emoji">🔥</span>
                        <span class="text-gray-800 text-lg sm:text-xl leading-snug" id="optA-text">힘이 넘치고 뭐든 하고 싶어요!</span>
                    </button>

                    <button onclick="selectOption('B')" class="w-full bg-white hover:bg-pink-50 border-4 border-pink-300 hover:border-pink-400 text-left p-4 rounded-2xl btn-press flex items-center space-x-3 transition-colors shadow-sm">
                        <span class="text-4xl shrink-0" id="optB-emoji">🧸</span>
                        <span class="text-gray-800 text-lg sm:text-xl leading-snug" id="optB-text">마음이 편안하고 따뜻해지고 싶어요!</span>
                    </button>
                </div>
            </div>

            <!-- Helper Note -->
            <p class="text-center text-sm text-amber-700 font-gamja-style text-lg">가장 내 마음과 닮은 그림 버튼을 누르면 돼요! 👇</p>
        </div>

        <!-- SCREEN 3: LOADING SCREEN (Hidden initially) -->
        <div id="loading-screen" class="hidden p-6 text-center flex-1 flex flex-col items-center justify-center my-auto space-y-6">
            <div class="relative">
                <div class="w-32 h-32 border-8 border-amber-200 border-t-pink-500 rounded-full animate-spin"></div>
                <div class="absolute inset-0 flex items-center justify-center text-5xl">🎬</div>
            </div>
            <div class="space-y-2">
                <h3 class="text-2xl text-gray-800 animate-pulse">나에게 어울리는 영화를 찾는 중...</h3>
                <p class="text-base text-amber-700 font-gamja-style text-xl">귀여운 아기 곰이 추천 영화표를 인쇄하고 있어요! 🐻🍿</p>
            </div>
        </div>

        <!-- SCREEN 4: RESULT SCREEN (Hidden initially) -->
        <div id="result-screen" class="hidden p-5 flex-1 flex flex-col justify-between overflow-y-auto">
            <div class="space-y-3.5 my-auto">
                <!-- Result Type Badge -->
                <div class="text-center">
                    <span id="result-badge" class="inline-block px-4 py-1.5 rounded-full text-base tracking-wide text-white bg-pink-500 shadow-sm border-2 border-white mb-1">
                        불꽃 도전형 🏆
                    </span>
                    <h3 class="text-sm text-gray-500">오늘 당신에게 어울리는 선물 같은 영화</h3>
                    <h2 id="result-title" class="text-2xl sm:text-3xl text-gray-900 mt-0.5">
                        《오버커머》
                    </h2>
                </div>

                <!-- Result Card Image / Emoji Banner -->
                <div id="result-card-bg" class="bg-gradient-to-br from-amber-100 to-orange-100 p-5 rounded-2xl border-4 border-amber-300 text-center relative overflow-hidden shadow-inner">
                    <div id="result-icon" class="text-6xl sm:text-7xl my-1 transform hover:scale-110 transition-transform cursor-pointer">
                        🏆
                    </div>
                </div>

                <!-- Movie Description Box -->
                <div class="bg-white border-2 border-gray-200 p-4 rounded-2xl space-y-2.5 text-left">
                    <div>
                        <span class="text-xs font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded-md">🎬 어떤 영화인가요?</span>
                        <p id="result-desc" class="text-sm text-gray-700 mt-1 leading-relaxed">
                            힘든 상황 속에서도 용기를 잃지 않고 끝까지 도전하는 감동 스토리에요!
                        </p>
                    </div>
                    <hr class="border-dashed border-gray-200">
                    <div>
                        <span class="text-xs font-bold text-pink-700 bg-pink-100 px-2 py-0.5 rounded-md">💌 오늘의 한마디</span>
                        <p id="result-quote" class="text-sm font-bold text-pink-900 mt-1 leading-relaxed">
                            "포기하지 마세요! 당신은 생각보다 훨씬 강하고 멋진 사람이에요."
                        </p>
                    </div>
                </div>

                <!-- Prescription Notice Box for Booth Operation -->
                <div class="bg-amber-100 border-2 border-amber-400 p-3.5 rounded-2xl text-center space-y-1">
                    <div class="flex items-center justify-center space-x-1.5 text-amber-900 font-bold text-sm sm:text-base">
                        <span class="text-xl">🎨</span>
                        <span>다음 단계 안내</span>
                    </div>
                    <p class="text-xs sm:text-sm text-amber-900 leading-relaxed font-gamja-style text-lg">
                        당신이 처방 받은 영화는 <span id="prescribed-movie-name" class="text-pink-600 font-bold underline">《오버커머》</span> 입니다.<br>
                        <span class="font-bold text-amber-950">다음 단계로 이동해 처방 봉투를 색칠해주세요! 🖍️✨</span>
                    </p>
                </div>
            </div>

            <!-- Restart Button -->
            <button onclick="restartQuiz()" class="w-full bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold text-xl py-3.5 px-6 rounded-2xl border-b-4 border-amber-600 btn-press mt-3 flex items-center justify-center space-x-2">
                <i class="fa-solid fa-rotate-right"></i>
                <span>다시 테스트하기</span>
            </button>
        </div>

        <!-- FOOTER -->
        <div class="bg-gray-50 border-t border-gray-200 py-2 px-4 text-center text-xs text-gray-500">
            신남초 동아리 축제 📚 독서영감 동아리
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Questions Data (Simplified for Elementary Schoolers)
        const questions = [
            {
                q: "☀️ 오늘 나의 기분은 어떤가요?",
                optA: { emoji: "🔥", text: "힘이 넘치고 뭐든 하고 싶어요!" },
                optB: { emoji: "🧸", text: "마음이 편안하고 따뜻해지고 싶어요!" }
            },
            {
                q: "🤝 친구와 마음이 맞지 않을 때는?",
                optA: { emoji: "💪", text: '"다시 해보자!" 당당하게 부딪쳐서 해결해요!' },
                optB: { emoji: "💌", text: '"속상했지?" 친구 이야기를 가만히 들어줘요!' }
            },
            {
                q: "🌟 영화 주인공이 된다면 나의 모습은?",
                optA: { emoji: "🏃", text: "끝까지 달려서 멋지게 역전승하는 주인공!" },
                optB: { emoji: "🌈", text: "내 진짜 모습을 보여주고 마음을 나눠주는 주인공!" }
            },
            {
                q: "🪄 지금 나에게 필요한 주문은?",
                optA: { emoji: "⚡", text: '"포기하지 마! 난 할 수 있어!"' },
                optB: { emoji: "💖", text: '"너는 있는 그대로 참 특별해!"' }
            }
        ];

        // Results Data
        const results = {
            overcomer: {
                badge: "🔥 불꽃 도전형",
                badgeBg: "bg-red-500",
                title: "《오버커머》 (Overcomer)",
                icon: "🏆",
                cardBg: "from-red-100 to-amber-100 border-red-300",
                desc: "어려운 환경에서도 용기를 잃지 않고 자기 한계를 넘어 끝까지 달려가는 크로스컨트리 감동 도전 이야기예요!",
                quote: "포기하지 마세요! 당신은 생각보다 훨씬 더 강하고 멋진 사람이에요. 💪✨"
            },
            wonder: {
                badge: "💛 따뜻한 공감형",
                badgeBg: "bg-amber-500",
                title: "《원더》 (Wonder)",
                icon: "💛",
                cardBg: "from-amber-100 to-yellow-100 border-amber-300",
                desc: "오해 속에서도 진심 어린 다정함으로 세상을 밝게 바꾸는 헬멧 속 멋진 소년 오기의 진짜 우정 이야기예요!",
                quote: "옳음과 다정함 중 선택해야 한다면, 언제나 다정함을 선택하세요! 🌈🎈"
            },
            bossbaby: {
                badge: "💼 엉뚱 통쾌형",
                badgeBg: "bg-blue-500",
                title: "《보스베이비》 (The Boss Baby)",
                icon: "💼",
                cardBg: "from-blue-100 to-indigo-100 border-blue-300",
                desc: "귀여운 얼굴 뒤에 숨겨진 반전 수트 아기! 엉뚱하지만 유쾌하고 시원시원한 대작전이 펼쳐져요!",
                quote: "답답한 일은 훌훌 날려버려요! 기발한 아이디어와 웃음이 당신의 무기예요! 😎⚡"
            }
        };

        let currentQuestion = 0;
        let countA = 0;
        let countB = 0;

        // Start Quiz
        function startQuiz() {
            currentQuestion = 0;
            countA = 0;
            countB = 0;
            
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('question-screen').classList.remove('hidden');
            
            renderQuestion();
        }

        // Render Current Question
        function renderQuestion() {
            const qData = questions[currentQuestion];
            
            // Update progress
            const progressPercent = Math.round(((currentQuestion + 1) / questions.length) * 100);
            document.getElementById('question-number').innerText = `질문 ${currentQuestion + 1} / ${questions.length}`;
            document.getElementById('progress-percent').innerText = `${progressPercent}% 완료`;
            document.getElementById('progress-bar').style.width = `${progressPercent}%`;

            // Update content
            document.getElementById('question-text').innerText = qData.q;
            document.getElementById('optA-emoji').innerText = qData.optA.emoji;
            document.getElementById('optA-text').innerText = qData.optA.text;
            document.getElementById('optB-emoji').innerText = qData.optB.emoji;
            document.getElementById('optB-text').innerText = qData.optB.text;
        }

        // Handle Option Selection
        function selectOption(choice) {
            if (choice === 'A') countA++;
            if (choice === 'B') countB++;

            currentQuestion++;

            if (currentQuestion < questions.length) {
                renderQuestion();
            } else {
                showLoading();
            }
        }

        // Show Loading Animation before Result
        function showLoading() {
            document.getElementById('question-screen').classList.add('hidden');
            document.getElementById('loading-screen').classList.remove('hidden');

            setTimeout(() => {
                document.getElementById('loading-screen').classList.add('hidden');
                showResult();
            }, 1400);
        }

        // Calculate and Show Result
        function showResult() {
            let resData;

            if (countA >= 3) {
                resData = results.overcomer;
            } else if (countB >= 3) {
                resData = results.wonder;
            } else {
                resData = results.bossbaby;
            }

            // Populate Result Data
            const badgeEl = document.getElementById('result-badge');
            badgeEl.innerText = resData.badge;
            badgeEl.className = `inline-block px-4 py-1.5 rounded-full text-base tracking-wide text-white shadow-sm border-2 border-white mb-1 ${resData.badgeBg}`;

            document.getElementById('result-title').innerText = resData.title;
            document.getElementById('result-icon').innerText = resData.icon;
            document.getElementById('result-desc').innerText = resData.desc;
            document.getElementById('result-quote').innerText = resData.quote;
            
            // Set prescribed movie title in the notice box
            document.getElementById('prescribed-movie-name').innerText = resData.title;

            const cardBg = document.getElementById('result-card-bg');
            cardBg.className = `bg-gradient-to-br ${resData.cardBg} p-5 rounded-2xl border-4 text-center relative overflow-hidden shadow-inner`;

            document.getElementById('result-screen').classList.remove('hidden');

            // Trigger Confetti Visual Effect
            triggerConfetti();
        }

        // Confetti Effect Trigger
        function triggerConfetti() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 85,
                    spread: 75,
                    origin: { y: 0.6 }
                });
            }
        }

        // Restart Quiz
        function restartQuiz() {
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        }
    </script>
</body>
</html>
